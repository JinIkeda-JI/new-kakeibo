{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Database",
      "type": "shell",
      "command": "docker-compose up -d postgres",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "services"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Stop Database",
      "type": "shell",
      "command": "docker-compose down",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Build Backend",
      "type": "shell",
      "command": "${workspaceFolder}\\kakeibo-backend\\gradlew.bat",
      "args": [
        "build",
        "-x",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}/kakeibo-backend"
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Start Backend",
      "type": "shell",
      "command": "${workspaceFolder}\\kakeibo-backend\\gradlew.bat",
      "args": [
        "bootRun"
      ],
      "options": {
        "cwd": "${workspaceFolder}/kakeibo-backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Starting KakeiboApplication.*$",
          "endsPattern": "^.*Started KakeiboApplication.*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "services"
      },
      "dependsOn": ["Start Database"]
    },
    {
      "label": "Install Frontend Dependencies",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}/kakeibo-frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/kakeibo-frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*VITE.*$",
          "endsPattern": "^.*Local:.*http://localhost.*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "services"
      }
    },
    {
      "label": "Start All Services",
      "dependsOn": [
        "Start Database",
        "Start Backend",
        "Start Frontend"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Stop All Services",
      "dependsOn": [
        "Stop Database"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    }
  ]
}
